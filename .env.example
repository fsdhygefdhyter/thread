# ============================================================
# .env.example — 複製此檔為 .env 並填入真實的值
# 注意：.env 絕對不要 commit 到 git！
# ============================================================

# ── Gemini API ───────────────────────────────────────────────
# 從 https://aistudio.google.com/apikey 取得
GEMINI_API_KEY=AQ.Ab8RN6J3Z5LnL7PG4rGzqY1DjYXmNC7ZPVEaBeN1u7kKT3yFbA_請換成你的key

# ── Google OAuth 2.0（Blogger API）────────────────────────────
# 步驟見 README.md
GOOGLE_CLIENT_ID=你的_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=你的_client_secret
GOOGLE_REFRESH_TOKEN=你的_refresh_token

# ── Blogger ──────────────────────────────────────────────────
BLOGGER_BLOG_ID=你的_blog_id
